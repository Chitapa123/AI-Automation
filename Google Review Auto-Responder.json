    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a friendly business owner responding to positive Google reviews. Your task is to write warm, genuine thank-you responses.\n\nGuidelines:\n1. Keep responses between 2-4 sentences\n2. Reference something specific from their review if possible\n3. Be grateful but not overly effusive\n4. Include a subtle invitation to return\n5. Sign off with the business name\n\nOutput ONLY the response text, no quotes or formatting."
