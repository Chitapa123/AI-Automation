      "id": "0f8ea549-2d02-4d64-b7de-a738e7599d80",
      "name": "Read from Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        -1248,
        240
      ],
      "notesInFlow": true,
      "alwaysOutputData": true,
      "credentials": {},
      "notes": "Reads previously processed review IDs to avoid duplicate responses. Create a sheet with columns: reviewId, rating, responseType, timestamp"
    },
    {
      "parameters": {
        "jsCode": "// Filter out reviews that have already been processed\nconst reviews = $('Parse Review Data').all();\nconst processedData = $('Read from Google Sheets').all();\n\ntry {\n  // Get list of already processed review IDs\n  const processedIds = new Set(\n    processedData\n      .map(item => item.json.reviewId)\n      .filter(id => id)\n  );\n  \n  // Filter to only new, unprocessed reviews\n  const newReviews = reviews.filter(review => {\n    // Skip if error in parsing\n    if (review.json.error || review.json.hasReviews === false) {\n      return false;\n    }\n    // Skip if already has owner response\n    if (review.json.hasOwnerResponse) {\n      return false;\n    }\n    // Skip if already processed by us\n    if (processedIds.has(review.json.reviewId)) {\n      return false;\n    }\n    return true;\n  });\n  \n  if (newReviews.length === 0) {\n    return [{\n      json: {\n        noNewReviews: true,\n        message: 'No new reviews to process',\n        totalFetched: reviews.length,\n        alreadyProcessed: processedIds.size\n      }\n    }];\n  }\n  \n  return newReviews;\n  \n} catch (error) {\n  return [{\n    json: {\n      error: true,\n      message: 'Failed to filter reviews: ' + error.message\n    }\n  }];\n}"
      },
