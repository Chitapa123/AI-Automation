      "id": "8cd76914-0541-454b-90a7-742875a85365",
      "name": "SerpAPI - Fetch Reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1696,
        240
      ],
      "notesInFlow": true,
      "credentials": {},
      "notes": "Fetches latest Google Maps reviews via SerpAPI. Sorted by newest first. Requires SerpAPI credential with 'api_key' as the query parameter name."
    },
    {
      "parameters": {
        "jsCode": "// Parse and format the raw SerpAPI response into clean review objects\nconst inputData = $input.first().json;\nconst businessName = $('Form Trigger').first().json['Business Name'];\nconst placeId = $('Form Trigger').first().json['Google Place ID'];\n\ntry {\n  const reviews = inputData.reviews || [];\n  \n  if (reviews.length === 0) {\n    return [{\n      json: {\n        hasReviews: false,\n        message: 'No reviews found for this business',\n        businessName: businessName,\n        placeId: placeId\n      }\n    }];\n  }\n  \n  // Format each review into a clean structure\n  const formattedReviews = reviews.map(review => ({\n    reviewId: review.review_id || `${review.user?.name}-${review.iso_date}`,\n    rating: review.rating,\n    reviewText: review.snippet || review.text || '',\n    reviewerName: review.user?.name || 'Anonymous',\n    reviewDate: review.iso_date || review.date,\n    relativeDate: review.date,\n    reviewerThumbnail: review.user?.thumbnail || '',\n    reviewLink: review.link || '',\n    responseText: review.response?.snippet || null,\n    hasOwnerResponse: !!review.response,\n    businessName: businessName,\n    placeId: placeId\n  }));\n  \n  return formattedReviews.map(review => ({ json: review }));\n  \n} catch (error) {\n  return [{\n    json: {\n      error: true,\n      message: 'Failed to parse review data: ' + error.message,\n      rawResponse: inputData\n    }\n  }];\n}"
      },
      "id": "3e0287de-1b51-46f9-a6d1-c466735b239b",
      "name": "Parse Review Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1472,
        240
      ],
      "notesInFlow": true,
      "notes": "Extracts and formats reviews into clean objects with reviewId, rating, text, and reviewer info. Handles missing fields gracefully."
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "1R9AlnPSdF_dkQhz4sXUrNOpExqICcxDBvKN1B9pmPb4",
          "mode": "list",
          "cachedResultName": "gmaps review responder",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/1R9AlnPSdF_dkQhz4sXUrNOpExqICcxDBvKN1B9pmPb4/edit?usp=drivesdk"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "ProcessedReviews",
          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/1R9AlnPSdF_dkQhz4sXUrNOpExqICcxDBvKN1B9pmPb4/edit#gid=0"
        },
