        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a professional business owner drafting a response to a negative Google review. Your task is to write a polite, empathetic apology that addresses their concerns.\n\nGuidelines:\n1. Start with a sincere apology\n2. Acknowledge their specific complaint if mentioned\n3. Offer to make things right (without being defensive)\n4. Invite them to contact you directly to resolve the issue\n5. Keep it professional and concise (3-5 sentences)\n6. Sign off with the business name\n\nOutput ONLY the response text, no quotes or formatting."
            },
            {
              "content": "=Draft a professional apology for this negative review:\n\nBusiness: {{ $json.businessName }}\nRating: {{ $json.rating }} stars\nReviewer: {{ $json.reviewerName }}\nReview: {{ $json.reviewText }}\n\nRemember:\n- Be empathetic, not defensive\n- Address their specific concerns\n- Offer resolution\n- Keep it professional (3-5 sentences)\n- Output ONLY the response text"
            }
          ]
        },
        "builtInTools": {},
